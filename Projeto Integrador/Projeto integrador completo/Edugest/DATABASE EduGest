
CREATE DATABASE IF NOT EXISTS escola_academica
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

USE escola_academica;

SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

DROP TABLE IF EXISTS pagamento;
DROP TABLE IF EXISTS mensalidade;
DROP TABLE IF EXISTS falta;
DROP TABLE IF EXISTS nota;
DROP TABLE IF EXISTS matricula;
DROP TABLE IF EXISTS disciplina;
DROP TABLE IF EXISTS professor;
DROP TABLE IF EXISTS aluno;
DROP TABLE IF EXISTS curso;

SET FOREIGN_KEY_CHECKS = 1;

CREATE TABLE curso (
  curso_id INT AUTO_INCREMENT PRIMARY KEY,
  nome VARCHAR(255) NOT NULL,
  codigo VARCHAR(100) NOT NULL UNIQUE,
  carga_horaria INT NOT NULL,
  nivel VARCHAR(100) NOT NULL
) ENGINE=InnoDB;

CREATE TABLE aluno (
  aluno_id INT AUTO_INCREMENT PRIMARY KEY,
  nome VARCHAR(255) NOT NULL,
  data_nascimento DATE NOT NULL,
  email VARCHAR(255) NOT NULL UNIQUE,
  cpf VARCHAR(20) NOT NULL UNIQUE,
  data_ingresso DATE NOT NULL,
  curso_id INT NOT NULL,
  status VARCHAR(100) NOT NULL,
  CONSTRAINT fk_aluno_curso
    FOREIGN KEY (curso_id) REFERENCES curso (curso_id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE professor (
  professor_id INT AUTO_INCREMENT PRIMARY KEY,
  nome VARCHAR(255) NOT NULL,
  email VARCHAR(255) NOT NULL UNIQUE,
  cpf VARCHAR(20) NOT NULL UNIQUE,
  area VARCHAR(255) NOT NULL,
  status VARCHAR(100) NOT NULL
) ENGINE=InnoDB;

CREATE TABLE disciplina (
  disciplina_id INT AUTO_INCREMENT PRIMARY KEY,
  nome VARCHAR(255) NOT NULL,
  codigo VARCHAR(100) NOT NULL UNIQUE,
  carga_horaria INT NOT NULL,
  curso_id INT NOT NULL,
  CONSTRAINT fk_disciplina_curso
    FOREIGN KEY (curso_id) REFERENCES curso (curso_id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE matricula (
  matricula_id INT AUTO_INCREMENT PRIMARY KEY,
  aluno_id INT NOT NULL,
  disciplina_id INT NOT NULL,
  data_matricula DATE NOT NULL,
  situacao VARCHAR(100) NOT NULL,
  CONSTRAINT uq_matricula_aluno_disciplina UNIQUE (aluno_id, disciplina_id),
  CONSTRAINT fk_matricula_aluno
    FOREIGN KEY (aluno_id) REFERENCES aluno(aluno_id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT,
  CONSTRAINT fk_matricula_disciplina
    FOREIGN KEY (disciplina_id) REFERENCES disciplina(disciplina_id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE nota (
  nota_id INT AUTO_INCREMENT PRIMARY KEY,
  matricula_id INT NOT NULL,
  avaliacao VARCHAR(255) NOT NULL,
  valor DECIMAL(10,2) NOT NULL,
  peso DECIMAL(10,2) NOT NULL,
  periodo VARCHAR(100) NOT NULL,
  CONSTRAINT fk_nota_matricula
    FOREIGN KEY (matricula_id) REFERENCES matricula (matricula_id)
    ON UPDATE CASCADE
    ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE falta (
  falta_id INT AUTO_INCREMENT PRIMARY KEY,
  matricula_id INT NOT NULL,
  data_falta DATE NOT NULL,
  aulas_perdidas INT NOT NULL,
  justificativa VARCHAR(255),
  CONSTRAINT fk_falta_matricula
    FOREIGN KEY (matricula_id) REFERENCES matricula(matricula_id)
    ON UPDATE CASCADE
    ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE mensalidade (
  mensalidade_id INT AUTO_INCREMENT PRIMARY KEY,
  aluno_id INT NOT NULL,
  competencia VARCHAR(20) NOT NULL,
  valor DECIMAL(10,2) NOT NULL,
  vencimento DATE NOT NULL,
  status VARCHAR(100) NOT NULL,
  CONSTRAINT fk_mensalidade_aluno
    FOREIGN KEY (aluno_id) REFERENCES aluno(aluno_id)
    ON UPDATE CASCADE
    ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE pagamento (
  pagamento_id INT AUTO_INCREMENT PRIMARY KEY,
  mensalidade_id INT NOT NULL,
  valor_pago DECIMAL(10,2) NOT NULL,
  data_pagamento DATE NOT NULL,
  metodo VARCHAR(100) NOT NULL,
  comprovante VARCHAR(255),
  CONSTRAINT fk_pagamento_mensalidade
    FOREIGN KEY (mensalidade_id) REFERENCES mensalidade(mensalidade_id)
    ON UPDATE CASCADE
    ON DELETE CASCADE
) ENGINE=InnoDB;


USE escola_academica;

-- =========================================================
-- ALTER TABLE
-- =========================================================

-- 1. CURSO
ALTER TABLE curso
ADD COLUMN modalidade VARCHAR(50) DEFAULT 'Presencial';


-- 2. ALUNO
ALTER TABLE aluno
ADD COLUMN telefone VARCHAR(20);


-- 3. PROFESSOR
ALTER TABLE professor
ADD COLUMN telefone VARCHAR(20);


-- 4. DISCIPLINA
ALTER TABLE disciplina
ADD COLUMN semestre INT DEFAULT 1;


-- 5. MATRICULA
ALTER TABLE matricula
ADD COLUMN observacao VARCHAR(255);


-- 6. NOTA
ALTER TABLE nota
ADD COLUMN data_avaliacao DATE;


-- 7. FALTA
ALTER TABLE falta
ADD COLUMN abono BOOLEAN DEFAULT FALSE;


-- 8. MENSALIDADE
ALTER TABLE mensalidade
ADD COLUMN desconto DECIMAL(10,2) DEFAULT 0.00;


-- 9. PAGAMENTO
ALTER TABLE pagamento
ADD COLUMN status_pagamento VARCHAR(50) DEFAULT 'Confirmado';


