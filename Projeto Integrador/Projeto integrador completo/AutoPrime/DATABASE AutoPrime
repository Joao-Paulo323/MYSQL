ADD COLUMN CustomerType VARCHAR(30);


-- 2. EMPLOYEES
-- Adiciona o departamento em que o funcionário trabalha
ALTER TABLE Employees
ADD COLUMN Department VARCHAR(50);


-- 3. SUPPLIERS
-- Adiciona o site do fornecedor
ALTER TABLE Suppliers
ADD COLUMN Website VARCHAR(150);


-- 4. SHIPPERS
-- Adiciona o e-mail da transportadora
ALTER TABLE Shippers
ADD COLUMN Email VARCHAR(120);


-- 5. CATEGORIES
-- Adiciona o status da categoria
ALTER TABLE Categories
ADD COLUMN CategoryStatus VARCHAR(20) DEFAULT 'ATIVA';


-- 6. PRODUCTS
-- Adiciona o peso do produto em quilogramas
ALTER TABLE Products
ADD COLUMN Weight DECIMAL(8,2);


-- 7. ORDERS
-- Adiciona o valor do frete do pedido
ALTER TABLE Orders
ADD COLUMN ShippingCost DECIMAL(10,2) DEFAULT 0.00;


-- 8. ORDERDETAILS
-- Adiciona o percentual de imposto aplicado ao item
ALTER TABLE OrderDetails
ADD COLUMN TaxPercent DECIMAL(5,2) DEFAULT 0.00;


-- 9. RETURNS
-- Adiciona o motivo da devolução
ALTER TABLE Returns
ADD COLUMN ReturnReason VARCHAR(200);


