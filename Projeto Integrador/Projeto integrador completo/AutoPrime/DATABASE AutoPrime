CREATE DATABASE AutoPrime;

CREATE TABLE cliente (
    cliente_id    BIGINT AUTO_INCREMENT PRIMARY KEY,
    nome          VARCHAR(255) NOT NULL,
    cpf_cnpj      VARCHAR(20) NOT NULL UNIQUE,
    email         VARCHAR(255) UNIQUE,
    telefone      VARCHAR(30),
    endereco      TEXT,
    data_cadastro  DATE NOT NULL,
    tipo_cliente   ENUM('PF', 'PJ') NOT NULL,
    status        ENUM('ativo', 'inativo') NOT NULL
);

CREATE TABLE veiculo (
    veiculo_id      BIGINT AUTO_INCREMENT PRIMARY KEY,
    vin_chassi      VARCHAR(50) NOT NULL UNIQUE,
    placa           VARCHAR(20) NOT NULL UNIQUE,
    marca           VARCHAR(100) NOT NULL,
    modelo          VARCHAR(100) NOT NULL,
    ano             INT NOT NULL,
    cor             VARCHAR(50),
    tipo            VARCHAR(30),
    origem          ENUM('novo', 'usado') NOT NULL,
    quilometragem   INT NOT NULL DEFAULT 0,
    preco_lista     DECIMAL(12,2) NOT NULL,
    status_estoque  ENUM('disponivel', 'reservado', 'vendido') NOT NULL,
    data_entrada    DATE NOT NULL
);

CREATE TABLE mecanico (
    mecanico_id    BIGINT AUTO_INCREMENT PRIMARY KEY,
    nome           VARCHAR(255) NOT NULL,
    cpf            VARCHAR(20) NOT NULL UNIQUE,
    telefone       VARCHAR(30),
    email          VARCHAR(255) UNIQUE,
    especialidade  VARCHAR(100),
    status         ENUM('ativo', 'inativo') NOT NULL
);

CREATE TABLE peca (
    peca_id         BIGINT AUTO_INCREMENT PRIMARY KEY,
    codigo          VARCHAR(50) NOT NULL UNIQUE,
    descricao       TEXT NOT NULL,
    fabricante      VARCHAR(100),
    preco_atual     DECIMAL(12,2) NOT NULL,
    estoque_atual   INT NOT NULL DEFAULT 0,
    estoque_minimo  INT NOT NULL DEFAULT 0,
    unidade         VARCHAR(20) NOT NULL,
    status          ENUM('ativo', 'inativo') NOT NULL
);

CREATE TABLE ordem_servico (
    os_id                  BIGINT AUTO_INCREMENT PRIMARY KEY,
    numero_os              VARCHAR(50) NOT NULL UNIQUE,
    cliente_id             BIGINT NOT NULL,
    veiculo_id             BIGINT NOT NULL,
    data_abertura          DATE NOT NULL,
    data_prevista_entrega  DATE,
    data_conclusao         DATE,
    status                 ENUM('aberta', 'em_execucao', 'aguardando_peca', 'concluida', 'cancelada') NOT NULL,
    descricao_problema     TEXT,
    mao_obra_total         DECIMAL(12,2) NOT NULL DEFAULT 0,
    total_pecas            DECIMAL(12,2) NOT NULL DEFAULT 0,
    valor_total            DECIMAL(12,2) NOT NULL DEFAULT 0,
    tipo_servico           ENUM('revisao', 'corretiva', 'garantia', 'outros') NOT NULL,
    CONSTRAINT fk_os_cliente
        FOREIGN KEY (cliente_id) REFERENCES cliente(cliente_id),
    CONSTRAINT fk_os_veiculo
        FOREIGN KEY (veiculo_id) REFERENCES veiculo(veiculo_id)
);

CREATE TABLE ordem_servico_mecanico (
    os_id        BIGINT NOT NULL,
    mecanico_id  BIGINT NOT NULL,
    PRIMARY KEY (os_id, mecanico_id),
    CONSTRAINT fk_osm_os
        FOREIGN KEY (os_id) REFERENCES ordem_servico(os_id),
    CONSTRAINT fk_osm_mecanico
        FOREIGN KEY (mecanico_id) REFERENCES mecanico(mecanico_id)
);

CREATE TABLE ordem_servico_peca (
    os_id    BIGINT NOT NULL,
    peca_id  BIGINT NOT NULL,
    PRIMARY KEY (os_id, peca_id),
    CONSTRAINT fk_osp_os
        FOREIGN KEY (os_id) REFERENCES ordem_servico(os_id),
    CONSTRAINT fk_osp_peca
        FOREIGN KEY (peca_id) REFERENCES peca(peca_id)
);

CREATE TABLE testdrive (
    testdrive_id         BIGINT AUTO_INCREMENT PRIMARY KEY,
    cliente_id           BIGINT NOT NULL,
    veiculo_id           BIGINT NOT NULL,
    inicio_real          DATETIME,
    fim_real             DATETIME,
    feedback_cliente     TEXT,
    quilometragem_inicio INT NOT NULL DEFAULT 0,
    quilometragem_fim    INT,
    status               ENUM('em_andamento', 'concluido', 'cancelado') NOT NULL,
    CONSTRAINT fk_testdrive_cliente
        FOREIGN KEY (cliente_id) REFERENCES cliente(cliente_id),
    CONSTRAINT fk_testdrive_veiculo
        FOREIGN KEY (veiculo_id) REFERENCES veiculo(veiculo_id)
);

CREATE TABLE venda (
    venda_id        BIGINT AUTO_INCREMENT PRIMARY KEY,
    cliente_id      BIGINT NOT NULL,
    veiculo_id      BIGINT NOT NULL UNIQUE,
    data_venda      DATE NOT NULL,
    valor_veiculo   DECIMAL(12,2) NOT NULL,
    desconto        DECIMAL(12,2) NOT NULL DEFAULT 0,
    valor_final     DECIMAL(12,2) NOT NULL,
    forma_pagamento ENUM('à vista', 'financiado') NOT NULL,
    status          ENUM('aberta', 'fechada', 'cancelada') NOT NULL,
    observacoes     TEXT,
    CONSTRAINT fk_venda_cliente
        FOREIGN KEY (cliente_id) REFERENCES cliente(cliente_id),
    CONSTRAINT fk_venda_veiculo
        FOREIGN KEY (veiculo_id) REFERENCES veiculo(veiculo_id)
);

